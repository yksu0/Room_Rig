{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"Flutter build runs in GitHub Actions; Vercel serves static output.\"",
  "buildCommand": "echo \"No Vercel build — deploy prebuilt build/web from CI.\"",
  "outputDirectory": "build/web",
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
